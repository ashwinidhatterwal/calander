{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hindu Calendar Festival Rule",
  "type": "object",
  "required": ["id", "name_hi", "name_en", "version", "scope", "conditions", "sources"],
  "properties": {
    "id": {"type": "string"},
    "name_hi": {"type": "string"},
    "name_en": {"type": "string"},
    "version": {"type": "integer", "minimum": 1},
    "scope": {
      "type": "object",
      "properties": {
        "regions": {"type": "array", "items": {"type": "string"}},
        "traditions": {"type": "array", "items": {"type": "string"}}
      }
    },
    "conditions": {"type": "array", "items": {"type": "object"}},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": {"type": "string"},
          "url": {"type": "string"},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
