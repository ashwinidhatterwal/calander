<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="2dp">
    <!-- Weights need a bounded parent; wrap_content made the title collapse. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_background"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:gravity="center"
        android:orientation="vertical">
        <TextView
            style="@style/CalendarWidgetText"
            android:id="@+id/widget_upcoming_kind"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.25"
            android:gravity="center"
            android:textAlignment="center"
            android:includeFontPadding="true"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="पर्व / व्रत"
            android:textColor="@color/widget_subtext"
            android:textSize="12sp"
            android:textStyle="normal"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="7dp"
            android:autoSizeMaxTextSize="12sp"
            android:autoSizeStepGranularity="1sp" />
        <TextView
            style="@style/CalendarWidgetText"
            android:id="@+id/widget_upcoming_title"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:gravity="center"
            android:textAlignment="center"
            android:includeFontPadding="true"
            android:maxLines="3"
            android:ellipsize="end"
            android:text="शारदीय नवरात्रि आरम्भ"
            android:textColor="@color/widget_text"
            android:textSize="20sp"
            android:textStyle="bold"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="8dp"
            android:autoSizeMaxTextSize="20sp"
            android:autoSizeStepGranularity="1sp" />
        <TextView
            style="@style/CalendarWidgetText"
            android:id="@+id/widget_upcoming_date"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.25"
            android:gravity="center"
            android:textAlignment="center"
            android:includeFontPadding="true"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="11 अक्टूबर 2026"
            android:textColor="@color/widget_accent"
            android:textSize="12sp"
            android:textStyle="normal"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="7dp"
            android:autoSizeMaxTextSize="12sp"
            android:autoSizeStepGranularity="1sp" />
    </LinearLayout>
</FrameLayout>
