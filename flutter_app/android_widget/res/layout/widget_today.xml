<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="2dp">
    <!-- Weights need a bounded parent; wrap_content made the title collapse. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_background"
        android:paddingHorizontal="10dp"
        android:paddingVertical="5dp"
        android:gravity="center"
        android:orientation="vertical">
        <TextView
            android:id="@+id/widget_today_date"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.25"
            android:gravity="center"
            android:textAlignment="center"
            android:includeFontPadding="true"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="रवि • 18 अक्टूबर"
            android:textColor="@color/widget_subtext"
            android:textSize="12sp"
            android:textStyle="normal"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeMaxTextSize="12sp"
            android:autoSizeStepGranularity="1sp" />
        <TextView
            android:id="@+id/widget_today_tithi"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="3"
            android:gravity="center"
            android:textAlignment="center"
            android:includeFontPadding="true"
            android:maxLines="3"
            android:ellipsize="end"
            android:text="शुक्ल पक्ष सप्तमी"
            android:textColor="@color/widget_text"
            android:textSize="20sp"
            android:textStyle="bold"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="8sp"
            android:autoSizeMaxTextSize="20sp"
            android:autoSizeStepGranularity="1sp" />
        <TextView
            android:id="@+id/widget_today_sun"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1.25"
            android:gravity="center"
            android:textAlignment="center"
            android:includeFontPadding="true"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="☀ 6:25 पु.   ◒ 6:25 अप."
            android:textColor="@color/widget_accent"
            android:textSize="12sp"
            android:textStyle="normal"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="7sp"
            android:autoSizeMaxTextSize="12sp"
            android:autoSizeStepGranularity="1sp" />
    </LinearLayout>
</FrameLayout>
