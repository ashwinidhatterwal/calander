<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:padding="10dp"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical">
    <TextView
        android:id="@+id/widget_today_date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAlignment="center"
        android:includeFontPadding="true"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginVertical="1dp"
        android:text="रवि • 27 सितंबर"
        android:textColor="@color/widget_subtext"
        android:textSize="11sp"
        />
    <TextView
        android:id="@+id/widget_today_tithi"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:textAlignment="center"
        android:includeFontPadding="true"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginVertical="1dp"
        android:text="कृष्ण पक्ष प्रतिपदा"
        android:textColor="@color/widget_text"
        android:textSize="19sp"
        android:textStyle="bold"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="12sp"
        android:autoSizeMaxTextSize="19sp"
        android:autoSizeStepGranularity="1sp"
        />
    <TextView
        android:id="@+id/widget_today_month"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAlignment="center"
        android:includeFontPadding="true"
        android:maxLines="1"
        android:ellipsize="end"
        android:layout_marginVertical="1dp"
        android:text="आश्विन मास"
        android:textColor="@color/widget_subtext"
        android:textSize="11sp"
        />
    <TextView
        android:id="@+id/widget_today_sun"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAlignment="center"
        android:includeFontPadding="true"
        android:maxLines="2"
        android:ellipsize="end"
        android:layout_marginVertical="1dp"
        android:text="☀ 06:25   ◒ 18:25"
        android:textColor="@color/widget_accent"
        android:textSize="12sp"
        android:textStyle="bold"
        />
    </LinearLayout>
</FrameLayout>
